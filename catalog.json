  "journeys": [
    {
      "id": 2957327,
      "title": "Writing From the Messy Middle",
      "url": "https://community.creativeliving.world/c/writing-from-the-messy-middle",
      "weeks": 1,
      "minutes_per_day": 20,
      "outcome": "Permission and prompts to create from exactly where you are, mess and all, instead of waiting until you've figured it out."
    },
    {
      "id": 2957305,
      "title": "Writing Your Future",
      "url": "https://community.creativeliving.world/c/writing-your-future",
      "weeks": 2,
      "minutes_per_day": 20,
      "outcome": "A week of writing the future you actually want, not a vision board, and a creative commitment to hold yourself to."
    },
    {
      "id": 2957298,
      "title": "Writing For Impact + Cultural Contribution",
      "url": "https://community.creativeliving.world/c/writing-for-impact-cultural-contribution",
      "weeks": 3,
      "minutes_per_day": 20,
      "outcome": "A clear sense of the threads in your work and the worldview behind them, so you can create work that matters without burning out."
    },
    {
      "id": 2957192,
      "title": "Uncover Original Thinking",
      "url": "https://community.creativeliving.world/c/uncover-original-thinking",
      "weeks": 5,
      "minutes_per_day": 20,
      "outcome": "Your own thinking back: daily rituals for noticing, the opinions you've been softening, and the obsessions that are really your material."
    },
    {
      "id": 2957184,
      "title": "Say The Damn Thing",
      "url": "https://community.creativeliving.world/c/say-the-damn-thing",
      "weeks": 2,
      "minutes_per_day": 20,
      "outcome": "The nerve to say what you actually mean, and a body that lets your ideas take up space."
    },
    {
      "id": 2957150,
      "title": "Publishing Your Work",
      "url": "https://community.creativeliving.world/c/publishing-your-work",
      "weeks": 4,
      "minutes_per_day": 20,
      "outcome": "Four weeks, four published pieces, and a body that no longer shrinks right before you hit send."
    },
    {
      "id": 2957105,
      "title": "Personal Column Writing",
      "url": "https://community.creativeliving.world/c/personal-column-writing",
      "weeks": 4,
      "minutes_per_day": 20,
      "outcome": "The form for a personal column, a pile of drafts written from strangers, humiliations and contradictions, and the one piece worth growing."
    },
    {
      "id": 2957088,
      "title": "New Season ( of Revelations )",
      "url": "https://community.creativeliving.world/c/new-season-of-revelations",
      "weeks": 2,
      "minutes_per_day": 60,
      "outcome": "An honest look at what you made, what you were protecting, and what's ready to shift, so you can choose your next season on purpose."
    },
    {
      "id": 2956383,
      "title": "Into The Deep : Tantra",
      "url": "https://community.creativeliving.world/c/into-the-deep-tantra",
      "weeks": 2,
      "minutes_per_day": 60,
      "outcome": "Kundalini practices and mantras that clear old patterns, sharpen your creative vision and give you the energy to turn ideas into form"
    },
    {
      "id": 2907482,
      "title": "Creating from The Body (YIN)",
      "url": "https://community.creativeliving.world/c/creating-from-the-body-yin",
      "weeks": 2,
      "minutes_per_day": 20,
      "outcome": "A body that's softer, clearer and ready to create, with short Yin, breath and sound practices to come back to whenever you feel stuck or full."
    },
    {
      "id": 2907481,
      "title": "Expanded Collection (NS 101)",
      "url": "https://community.creativeliving.world/c/expanded-collection-ns-101",
      "weeks": 2,
      "minutes_per_day": 15,
      "outcome": "An understanding of how your nervous system shapes your creativity, and simple practices to hold more visibility and expansion without shutting down."
    }
